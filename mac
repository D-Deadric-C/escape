#!/usr/bin/env bash
# escape — macOS one-line installer.
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "run with sudo"; exit 1; }
REAL_USER="${SUDO_USER:-$USER}"
run_user(){ sudo -u "$REAL_USER" bash -lc "$*"; }

cat > /usr/local/bin/escape <<'ESCAPE_EOF'
#!/usr/bin/env bash
# escape (macOS) — one command to tunnel all traffic through your server, on any network.
# Auto-selects transport (UDP -> TCP-443 fallback) and auto-enrolls on first run.
# Requires: Homebrew wireguard-tools  (installed by install-macos.sh).
#   escape start | stop | status
set -uo pipefail
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"   # so wg-quick is found under sudo

ESCAPE_DIR=/etc/escape
CONF="$ESCAPE_DIR/escape.conf"
WSTUNNEL="$ESCAPE_DIR/wstunnel"
NAME=escape
WGCONF="/etc/wireguard/$NAME.conf"
LOCALUDP=51820
ENROLL_PORT=9091
LOG=/tmp/escape-wstunnel.log

# --- baked into the package (not per-user secrets) ---
SERVER_IP="40.81.225.20"
ENROLL_SECRET="c08dc6a5b168ed6f9e2a3dd086ec65752b87ab932d062e64"

die() { echo "escape: $*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || exec sudo "$0" "$@"; }
egress_ip() {   # DNS-independent: talk to 1.1.1.1 by IP, read back our public IP
  curl -s --max-time "${1:-12}" https://1.1.1.1/cdn-cgi/trace 2>/dev/null | sed -n 's/^ip=//p'
}
server_ip()  { awk -F'[ :]+' '/^Endpoint/{print $3; exit}' "$CONF"; }
server_port(){ awk -F'[ :]+' '/^Endpoint/{print $4; exit}' "$CONF"; }
# portable JSON string-field extractor (BSD/GNU sed)
jget() { sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'; }

build_wg_conf() {          # $1 = endpoint
  umask 077; mkdir -p "$(dirname "$WGCONF")"
  cp "$CONF" "$WGCONF"
  sed -i '' "s|^Endpoint *=.*|Endpoint = $1|" "$WGCONF"
  # macOS: keep DNS= (wg-quick sets it via networksetup). Just shrink MTU.
  sed -i '' 's/^MTU *=.*/MTU = 1280/' "$WGCONF"
}

teardown() {
  wg-quick down "$WGCONF" 2>/dev/null || wg-quick down "$NAME" 2>/dev/null || true
  pkill -f 'wstunnel client' 2>/dev/null || true
  local s; s=$(server_ip 2>/dev/null || true)
  [[ -n "$s" ]] && route -n delete -host "$s" >/dev/null 2>&1 || true
}

# bring wg up, showing the real error if it fails (e.g. missing wireguard-go)
wg_up() {
  local out
  if ! out=$(wg-quick up "$WGCONF" 2>&1); then
    echo "escape: wg-quick could not start the tunnel —"
    echo "$out" | sed 's/^/    /' | tail -5
    wg-quick down "$WGCONF" >/dev/null 2>&1 || true
    return 1
  fi
}

enroll() {
  echo "escape: first run — registering this device with the server…"
  [[ -x "$WSTUNNEL" ]] || die "wstunnel engine missing at $WSTUNNEL"
  command -v wg >/dev/null || die "wireguard-tools not installed (brew install wireguard-tools)"
  pkill -f 'wstunnel client' 2>/dev/null || true
  nohup "$WSTUNNEL" client -L "tcp://127.0.0.1:$ENROLL_PORT:127.0.0.1:8080" \
    --tls-sni-override www.microsoft.com "wss://$SERVER_IP:443" >"$LOG" 2>&1 &
  local wpid=$!; sleep 3
  local priv pub resp; priv=$(wg genkey); pub=$(printf '%s' "$priv" | wg pubkey)
  resp=$(curl -s --max-time 25 -X POST "http://127.0.0.1:$ENROLL_PORT/enroll" \
    -H 'Content-Type: application/json' -d "{\"secret\":\"$ENROLL_SECRET\",\"pubkey\":\"$pub\"}")
  kill "$wpid" 2>/dev/null || true; pkill -f 'wstunnel client' 2>/dev/null || true
  local spub ep addr psk dns
  spub=$(printf '%s' "$resp" | jget server_pubkey)
  ep=$(printf   '%s' "$resp" | jget endpoint)
  addr=$(printf '%s' "$resp" | jget address)
  psk=$(printf  '%s' "$resp" | jget psk)
  dns=$(printf  '%s' "$resp" | jget dns)
  [[ -n "$spub" && -n "$ep" && -n "$addr" && -n "$psk" ]] || die "enrollment failed: ${resp:-no response}"
  umask 077; mkdir -p "$ESCAPE_DIR"
  cat > "$CONF" <<CONFEOF
[Interface]
PrivateKey = $priv
Address = $addr
DNS = ${dns:-1.1.1.1}
MTU = 1380

[Peer]
PublicKey = $spub
PresharedKey = $psk
Endpoint = $ep
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
CONFEOF
  chmod 600 "$CONF"
  echo "escape: this device is now registered (address $addr)."
}

start_udp() {
  local srv="$1" sport="$2"
  echo "escape: trying fast path (WireGuard/UDP)…"
  wg-quick down "$WGCONF" >/dev/null 2>&1 || true
  build_wg_conf "$srv:$sport"
  wg_up || return 1
  sleep 3
  [[ "$(egress_ip 8)" == "$srv" ]] && return 0
  wg-quick down "$WGCONF" >/dev/null 2>&1 || true; return 1
}

# route the server via the physical gateway so wstunnel bypasses the tunnel
add_exclude() {
  local srv="$1" gw="$2"
  route -n delete -host "$srv" >/dev/null 2>&1 || true
  [[ -n "$gw" ]] && route -n add -host "$srv" "$gw" >/dev/null 2>&1 || true
}

start_tcp() {
  local srv="$1"
  echo "escape: UDP blocked — switching to TCP-443 (HTTPS-disguised)…"
  [[ -x "$WSTUNNEL" ]] || die "wstunnel missing at $WSTUNNEL"
  wg-quick down "$WGCONF" >/dev/null 2>&1 || true
  local gw="${PHYS_GW:-}"
  [[ -z "$gw" ]] && gw=$(route -n get "$srv" 2>/dev/null | awk '/gateway:/{print $2; exit}')
  [[ -n "$gw" ]] || { echo "escape: couldn't find your network gateway — can't route around the tunnel"; return 1; }
  echo "escape: routing $srv directly via $gw (so the tunnel doesn't loop)"
  add_exclude "$srv" "$gw"
  pkill -f 'wstunnel client' 2>/dev/null || true
  nohup "$WSTUNNEL" client -L "udp://$LOCALUDP:127.0.0.1:443?timeout_sec=0" \
    --tls-sni-override www.microsoft.com "wss://$srv:443" >"$LOG" 2>&1 &
  sleep 2
  pgrep -f 'wstunnel client' >/dev/null || { echo "escape: wstunnel failed to start:"; tail -5 "$LOG"; return 1; }
  build_wg_conf "127.0.0.1:$LOCALUDP"
  wg_up || return 1
  add_exclude "$srv" "$gw"   # re-apply: macOS wg-quick can wipe it during 'up'
  local i
  for i in 1 2 3 4 5; do
    sleep 3
    [[ "$(egress_ip 8)" == "$srv" ]] && return 0
    add_exclude "$srv" "$gw"
  done
  echo "escape: tunnel up but no traffic. wstunnel log:"; tail -4 "$LOG"
  echo "escape: route to server is:"; route -n get "$srv" 2>/dev/null | sed 's/^/    /'
  return 1
}

cmd_start() {
  command -v wg-quick >/dev/null || die "wireguard-tools not installed (brew install wireguard-tools)"
  [[ -f "$CONF" ]] || enroll
  local srv sport; srv=$(server_ip); sport=$(server_port)
  [[ -n "$srv" ]] || die "could not read server from $CONF"
  teardown
  # capture the physical default gateway now (before any tunnel changes routing)
  PHYS_GW=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2; exit}')
  start_udp "$srv" "$sport" && { echo "escape: connected ✅ (UDP)  your public IP is now $srv"; exit 0; }
  start_tcp "$srv"          && { echo "escape: connected ✅ (TCP-443)  your public IP is now $srv"; exit 0; }
  echo "escape: could not establish a tunnel here — rolled back, internet unaffected."; teardown; exit 2
}

cmd_stop()   { teardown; echo "escape: disconnected — back on the normal network."; }
cmd_status() {   # no sudo needed: just compare the public IP
  local e; e=$(egress_ip 8)
  if [[ -n "$e" && "$e" == "$SERVER_IP" ]]; then
    echo "escape: UP ✅  (public IP: $e)"
    pgrep -f 'wstunnel client' >/dev/null 2>&1 && echo "        transport: TCP-443" || echo "        transport: UDP"
  else
    echo "escape: down  (public IP: ${e:-unknown})"
  fi
}

# elevate for network-changing commands, preserving the subcommand (fixes self-sudo dropping it)
if [[ "${1:-}" == "start" || "${1:-}" == "stop" ]] && [[ $EUID -ne 0 ]]; then
  exec sudo "$0" "$@"
fi

case "${1:-}" in
  start)  shift; cmd_start "$@";;
  stop)   shift; cmd_stop  "$@";;
  status) shift; cmd_status "$@";;
  *) echo "usage: escape {start|stop|status}"; exit 1;;
esac
ESCAPE_EOF
chmod +x /usr/local/bin/escape
printf '#!/usr/bin/env bash\nexec /usr/local/bin/escape start "$@"\n'  > /usr/local/bin/escape_start
printf '#!/usr/bin/env bash\nexec /usr/local/bin/escape status "$@"\n' > /usr/local/bin/escape_status
printf '#!/usr/bin/env bash\nexec /usr/local/bin/escape stop "$@"\n'   > /usr/local/bin/escape_stop
chmod +x /usr/local/bin/escape_start /usr/local/bin/escape_status /usr/local/bin/escape_stop

if ! run_user "command -v brew" >/dev/null 2>&1; then
  echo "[*] Installing Homebrew (one-time)…"
  run_user 'NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'
fi
BREW="$(run_user 'command -v brew' 2>/dev/null || true)"; [[ -n "$BREW" ]] || BREW="$([[ -x /opt/homebrew/bin/brew ]] && echo /opt/homebrew/bin/brew || echo /usr/local/bin/brew)"
run_user "command -v wg-quick"     >/dev/null 2>&1 || { echo "[*] Installing wireguard-tools…"; run_user "$BREW install wireguard-tools"; }
run_user "command -v wireguard-go" >/dev/null 2>&1 || { echo "[*] Installing wireguard-go…";    run_user "$BREW install wireguard-go"; }

# wstunnel from github.io Pages (reachable where GitHub releases are blocked)
case "$(uname -m)" in arm64) A=arm64;; *) A=amd64;; esac
mkdir -p /etc/escape; chmod 700 /etc/escape
echo "[*] Downloading wstunnel (darwin $A)…"
curl -fSL "https://d-deadric-c.github.io/escape/wstunnel-darwin-${A}" -o /etc/escape/wstunnel || { echo "ERROR: wstunnel download failed"; exit 1; }
chmod 755 /etc/escape/wstunnel
xattr -d com.apple.quarantine /etc/escape/wstunnel 2>/dev/null || true
[[ -s /etc/escape/wstunnel ]] || { echo "ERROR: wstunnel not installed"; exit 1; }

echo
echo "======================================"
echo "  ✅  escape — installation complete!"
echo "======================================"
echo "  connect:  escape_start     check: escape_status     stop: escape_stop"
echo
